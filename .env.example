# Copy to .env (never commit it) or set these on the host.
PORT=8080
FIREBASE_PROJECT_ID=speakup-ca500
# Neon connection string. Leave empty to use the in-memory store.
DATABASE_URL=
# Comma-separated exact origins allowed to call the API.
ALLOWED_ORIGINS=https://public-speaking-lemon.vercel.app
# Allow http://localhost:<any port> for local Flutter runs.
ALLOW_LOCALHOST=true
# Comma-separated emails (verified in Firebase) that can manage bookings.
ADMIN_EMAILS=
